# Copy this file to keystore.properties and fill in your own values.
# NEVER commit keystore.properties or the .jks/.keystore file itself.
#
# Environment variables take precedence over this file:
#   KEYSTORE_PATH, STORE_PASSWORD, KEY_ALIAS, KEY_PASSWORD
#
# storeFile may be absolute or relative to the repository root.
# Use forward slashes (C:/keys/...) or escaped backslashes (C:\\keys\\...)
# in this Java properties file.

storeFile=C:/keys/feather-release.keystore
storePassword=CHANGE_ME
keyAlias=feather_release_key
keyPassword=CHANGE_ME
